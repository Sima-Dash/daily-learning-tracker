.container.mt-5
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      .card.signup-card
        .card-body.p-4

          .text-center.mb-4

            = image_tag "learning_tracker_icon.png",
                alt: t("application.title"),
                class: "login-app-icon"

            h2.text-primary.mb-2
              = t("application.title")

            p.text-muted.mb-3
              = t("users.tagline")

            h3.signup-title.text-success.mb-0
              = t("users.create_account")

          - if @user.errors.any?
            .alert.alert-danger
              h5
                = t("users.errors.title", 
                    count: @user.errors.count) 

              ul.mb-0
                - @user.errors.full_messages.each do |message|
                  li = message

          = form_with model: @user, local: true, data: { controller: "validation", validation_message: t("validation.required") } do |form| 

            .mb-3
              = form.label :name, class: "form-label" do
                = t("users.full_name") 
                span.text-danger *

              = form.text_field :name,
                  class: "form-control",
                  placeholder: t("users.full_name_placeholder"), 
                  required: true

            .mb-3
              = form.label :email, class: "form-label" do
                = t("users.email") 
                span.text-danger *

              = form.email_field :email,
                  class: "form-control",
                  placeholder: t("users.email_placeholder"), 
                  required: true

            .mb-3
              = form.label :password, class: "form-label" do
                = t("users.password") 
                span.text-danger *

              = form.password_field :password,
                  class: "form-control",
                  placeholder: t("users.password_placeholder"), 
                  required: true, 
                  autocomplete: "new-password"

            .mb-3
              = form.label :password_confirmation, class: "form-label" do
                = t("users.password_confirmation") 
                span.text-danger *

              = form.password_field :password_confirmation,
                  class: "form-control",
                  placeholder: t("users.password_confirmation_placeholder"), 
                  required: true,
                  autocomplete: "new-password"

            .d-grid.mt-4
              = form.submit t("users.sign_up"), class: "btn btn-success btn-lg"

            .mt-4.text-center
              = link_to t("users.back"),
                  learning_entries_path,
                  class: "btn btn-outline-secondary"