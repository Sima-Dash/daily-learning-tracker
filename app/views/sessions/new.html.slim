.container.mt-5

  .row.justify-content-center

    .col-12.col-sm-10.col-md-8.col-lg-6.col-xl-5

      .card.shadow-lg

        .card-body.p-4

          .text-center.mb-3
            = image_tag "learning_tracker_icon.png",
                alt: t("sessions.title"),
                class: "login-app-icon"

          h2.text-center.text-primary.mb-2
            = t("sessions.title")


          p.text-center.text-muted.mb-4
            = t("sessions.tagline")

          = form_with url: login_path, method: :post, local: true, data: { controller: "validation", validation_message: t("validation.required") } do |form| 
            .mb-3

              = form.label :email do
                = t("sessions.email")  
                span.text-danger *

              = form.email_field :email,
                  class: "form-control",
                  placeholder: t("sessions.email_placeholder"), 
                  required: true,
                  autocomplete: "email"

            .mb-3

              = form.label :password do
                = t("sessions.password") 
                span.text-danger *

              = form.password_field :password,
                  class: "form-control",
                  placeholder: t("sessions.password_placeholder"),
                  required: true,
                  autocomplete: "current-password"

            .d-grid.mt-4

              = form.submit t("sessions.login"), 
                  class: "btn btn-primary"

          .text-center.mt-4

            p.mb-2
              = t("sessions.no_account") 

            = link_to t("sessions.create_account"), 
                new_user_path,
                class: "btn btn-outline-success"

          
