- if entry.errors.any?

  .alert.alert-danger

    h5
      = t("learning_entries.errors", count: entry.errors.count)
      
      | prevented this entry from saving:

    ul.mb-0

      - entry.errors.full_messages.each do |message|

        li = message

p.text-muted.mb-4
  span.text-danger
    | *

  = t("learning_entries.required_fields_note")

= form_with model: entry, data: { controller: "validation", validation_message: t("validation.required") } do |f|

  .mb-3

    = f.label :date do
      = t("learning_entries.date")

      span.text-danger *

    = f.date_field :date,
        class: "form-control",
        required: true

  .mb-3

    = f.label :topic do
      = t("learning_entries.topic") 

      span.text-danger *

    = f.text_field :topic,
        class: "form-control",
        placeholder: t("learning_entries.topic_placeholder"), 
        required: true

  .mb-3

    = f.label :hours do
      = t("learning_entries.hours") 

      span.text-danger *

    = f.number_field :hours,
        class: "form-control",
        placeholder: t("learning_entries.hours_placeholder"), 
        required: true

  .mb-3

    = f.label :notes do
      = t("learning_entries.notes")

      span.text-danger *

    = f.text_area :notes,
         class: "form-control",
         rows: 5,
         placeholder: t("learning_entries.notes_placeholder"),
         required: true

  .d-grid
    = f.submit(entry.persisted? ? t("learning_entries.update") : t("learning_entries.create"), class: "btn btn-primary btn-lg w-100")