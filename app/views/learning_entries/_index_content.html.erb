<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h1 class="page-title text-primary mb-1">Daily Learning Tracker</h1>

    <p class="text-muted">Track your daily learning progress.</p>

  </div>

<%= link_to "➕ Add New Entry", new_learning_entry_path, class: "btn btn-success px-4" %>

</div>

<!-- SEARCH BAR START -->

    <div class="row mb-4">

      <div class="col-md-8">

        <%= form_with url: learning_entries_path,
          method: :get,
          local: true,
          class: "search-form d-flex gap-2" do %>

         <%= text_field_tag :search, 
                            params[:search], 
                            class: "form-control", 
                            placeholder: "🔍 Search by topic..." %>

          <%= submit_tag "Search", class: "btn btn-primary" %>

          <%= link_to "Reset", learning_entries_path, class: "btn btn-secondary" %>

        <% end %>

      </div>

    </div>

<% if @entries.any? %>

<% @entries.each do |entry| %>

  <%= render "learning_entry", entry: entry %>

<% end %>

<% else %>
 <% if params[:search].present? %>
   <div class="alert alert-warning text-center">

     No learning entries found for
     <strong>"<%= params[:search] %>"</strong>.

    </div>

  <% else %>

  <div class="alert alert-info text-center">

    No learning entries found.
  
  </div>

  <% end %>

<% end %>




