<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h1 class="page-title text-primary mb-1">Daily Learning Tracker</h1>

    <p class="text-muted">Track your daily learning progress.</p>

  </div>

<%= link_to "➕ Add New Entry", new_learning_entry_path, class: "btn btn-success px-4" %>

</div>

<% if @entries.any? %>

<% @entries.each do |entry| %>

  <%= render "learning_entry", entry: entry %>

<% end %>

<% else %>

  <div class="alert alert-info text-center">

    No learning entries found.
  
  </div>

<% end %>


