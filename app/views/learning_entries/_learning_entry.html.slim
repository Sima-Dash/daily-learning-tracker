.card.learning-card.shadow-sm.mb-4

  .card-body

    .d-flex.justify-content-between.align-items-center

      h4.text-primary.mb-0

        = entry.topic

      span.badge.bg-success.fs-6

        = "#{entry.hours} hrs"

    hr

    p

       strong
         | Date:

       = entry.date

    p

       strong
         | Notes:

       = entry.notes

    .d-flex.gap-2.mt-4

        = link_to "✏️ Edit",
            edit_learning_entry_path(entry),
            class: "btn btn-warning"

        = link_to "🗑️ Delete",
          learning_entry_path(entry),
          class: "btn btn-danger",
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }