  .card.learning-card.shadow-sm.rounded-3.mb-4 id=dom_id(entry)

    .card-body.p-4

      .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-2

        h4.text-primary.fw-bold.mb-0

          = entry.topic

        span.badge.bg-success.fs-6.px-3.py-2

          = t("learning_entries.card.hours", hours: entry.hours)

      hr.my-3

      p.mb-2

        strong.me-1
          = t("learning_entries.card.date")

        = entry.date

      p.mb-0

        strong.me-1
          = t("learning_entries.card.notes")

        = entry.notes

      .d-flex.flex-column.flex-sm-row.gap-2.mt-4

        = link_to t("learning_entries.actions.edit"),
            edit_learning_entry_path(entry),
            class: "btn btn-warning",
            data: { turbo_frame: "_top" }

        = link_to t("learning_entries.actions.delete"),
            learning_entry_path(entry),
            class: "btn btn-danger",
            data: { turbo_method: :delete,
                    turbo_confirm: t("learning_entries.confirmations.delete"),
                    turbo_frame: "_top" }