.card.learning-card.shadow-sm.rounded-3.mb-4

  .card-body.p-4

    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-2

      h4.text-primary.fw-bold.mb-0

        = entry.topic

      span.badge.bg-success.fs-6.px-3.py-2

        = "#{entry.hours} hrs"

    hr.my-3

    p.mb-2

       strong.me-1
         | Date:

       = entry.date

    p.mb-0

       strong.me-1
         | Notes:

       = entry.notes

    .d-flex.flex-column.flex-sm-row.gap-2.mt-4

        = link_to "✏️ Edit",
            edit_learning_entry_path(entry),
            class: "btn btn-warning"

        = link_to "🗑️ Delete",
          learning_entry_path(entry),
          class: "btn btn-danger",
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }