nav.navbar.app-navbar.bg-light.shadow-sm.rounded.mb-4
  .container-fluid

    .desktop-navbar.d-none.d-md-flex.justify-content-between.align-items-center.w-100.py-2

      .navbar-brand-section
        = link_to t("navigation.daily_learning_tracker"), learning_entries_path, class: "navbar-brand fw-bold text-primary d-block"
        p.text-muted.mb-0
          = t("learning_entries.tagline")

      .desktop-nav-actions.d-flex.align-items-center.gap-2
        = link_to t("navigation.add_new_entry"), new_learning_entry_path, class: "btn btn-success px-4"

        .language-switcher.d-flex.gap-1
          = link_to t("navigation.english"), set_locale_path(:en), class: "btn btn-sm #{I18n.locale == :en ? 'btn-primary' : 'btn-outline-primary'}"
          = link_to t("navigation.japanese"), set_locale_path(:ja), class: "btn btn-sm #{I18n.locale == :ja ? 'btn-primary' : 'btn-outline-primary'}"

        = button_to t("navigation.logout"), logout_path, method: :delete, class: "btn btn-danger px-4"

    .mobile-navbar.d-flex.d-md-none.justify-content-between.align-items-center.w-100.py-2

      = link_to t("navigation.daily_learning_tracker"), learning_entries_path, class: "navbar-brand fw-bold text-primary mb-0"

      details.mobile-menu
        summary.mobile-menu-button aria-label="Menu"
          | ☰

        .mobile-menu-content
          .d-flex.gap-2.w-100.mb-3.pb-3.border-bottom
            = link_to t("navigation.english"), set_locale_path(:en), class: "btn btn-sm flex-fill #{I18n.locale == :en ? 'btn-primary' : 'btn-outline-primary'}"
            = link_to t("navigation.japanese"), set_locale_path(:ja), class: "btn btn-sm flex-fill #{I18n.locale == :ja ? 'btn-primary' : 'btn-outline-primary'}"

          = button_to t("navigation.logout"), logout_path, method: :delete, class: "mobile-logout-button"

.mobile-tagline.d-md-none
  p.text-muted.mb-3
    = t("learning_entries.tagline")

.mobile-add-entry.d-md-none.mb-4
  = link_to t("navigation.add_new_entry"), new_learning_entry_path, class: "btn btn-success w-100" 
  
/ SEARCH BAR START

.row.mb-4

  .col-12.col-md-8

    = form_with url: learning_entries_path,
        method: :get,
        local: true,
        class: "search-form d-flex flex-column flex-md-row gap-2" do

      = text_field_tag :search,
          params[:search],
          class: "form-control",
          placeholder: t("learning_entries.search_placeholder")

      = submit_tag t("learning_entries.search"),
          class: "btn btn-primary"

      = link_to t("learning_entries.reset"),
          learning_entries_path,
          class: "btn btn-secondary"

- if @entries.any?

  - @entries.each do |entry|

    = render "learning_entry",
        entry: entry

- else

  - if params[:search].present?

    .alert.alert-warning.text-center
      = t("learning_entries.no_entries_found_for", search: params[:search])
      
  - else

    .alert.alert-info.text-center

      = t("learning_entries.no_entries_found")