nav.navbar.bg-light.shadow-sm.rounded.mb-4

  .container-fluid.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center

    .mb-3.mb-md-0

      = link_to "Daily Learning Tracker",
        learning_entries_path,
        class: "navbar-brand fw-bold text-primary d-block"

      p.text-muted.mb-0
        | Track your daily learning progress.

    .d-flex.flex-column.flex-sm-row.gap-2

      = link_to "➕ Add New Entry",
          new_learning_entry_path,
          class: "btn btn-success" 

      = button_to "Logout", 
          logout_path, 
          method: :delete, 
          class: "btn btn-danger" 

/ SEARCH BAR START

.row.mb-4

  .col-md-8

    = form_with url: learning_entries_path,
        method: :get,
        local: true,
        class: "search-form d-flex gap-2" do

      = text_field_tag :search,
          params[:search],
          class: "form-control",
          placeholder: "🔍 Search by topic..."

      = submit_tag "Search",
          class: "btn btn-primary"

      = link_to "Reset",
          learning_entries_path,
          class: "btn btn-secondary"

- if @entries.any?

  - @entries.each do |entry|

    = render "learning_entry",
        entry: entry

- else

  - if params[:search].present?

    .alert.alert-warning.text-center

      | No learning entries found for 
      strong
        | "#{params[:search]}"
      | .

  - else

    .alert.alert-info.text-center

      | No learning entries found.