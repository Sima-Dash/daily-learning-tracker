<% if entry.errors.any? %>

  <div class="alert alert-danger">

    <h5>

      <%= pluralize(entry.errors.count, "error") %> prevented this entry from saving:

    </h5>

    <ul class="mb-0">

      <% entry.errors.full_messages.each do |message| %>

        <li><%= message %></li>

      <% end %>

    </ul>

  </div>

<% end %>

<p class="text-muted mb-4">
  <span class="text-danger">*</span> indicates required fields.
</p>

<%= form_with model: entry do |f| %>

  <div class="mb-3">

    <%= f.label :date do %>

      Date <span class="text-danger">*</span>

    <% end %>

    <%= f.date_field :date,
          class: "form-control",
          required: true %>

  </div>

  <div class="mb-3">

    <%= f.label :topic do %>

      Topic <span class="text-danger">*</span>

    <% end %>

    <%= f.text_field :topic,
          class: "form-control",
          placeholder: "Enter topic",
          required: true %>

  </div>

  <div class="mb-3">

    <%= f.label :hours do %>

      Hours <span class="text-danger">*</span>

    <% end %>

    <%= f.number_field :hours,
          class: "form-control",
          placeholder: "Enter hours",
          required: true %>

  </div>

  <div class="mb-3">

    <%= f.label :notes do %>

      Notes <span class="text-danger">*</span>

    <% end %>

    <%= f.text_area :notes,
          class: "form-control",
          rows: 5,
          placeholder: "Write your learning notes...",
          required: true %>

  </div>

  <div class="d-grid">

    <%= f.submit(
      entry.persisted? ? "💾 Update Entry" : "✅ Create Entry",
      class: "btn btn-primary btn-lg w-100"
    ) %>
    
  </div>

<% end %>