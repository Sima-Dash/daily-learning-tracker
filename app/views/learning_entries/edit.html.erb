<h1>Edit Learning Entry</h1>

<div class="form-container">

<% if @entry.errors.any? %>
  <div class="error-box">
   <h3>Please fix the following errors:</h3>

   <ul>
      <% @entry.errors.full_messages.each do |message| %>
         <li><%= message %></li>
      <% end %>
   </ul>
  </div>
<% end %>

<%= form_with model:@entry do |f| %>
    <p>
        <%= f.label :date %>
        <%= f.date_field :date %>
    </p>

    <p>
        <%= f.label :topic %>
        <%= f.text_field :topic %>
    </p>

    <p>
        <%= f.label :hours %>
        <%= f.number_field :hours %>
    </p>

    <p>
        <%= f.label :notes %>
        <%= f.text_area :notes %>
    </p>

    <%= f.submit "Update", class: "button" %>
<% end %>

</div>

<p>
    <%= link_to "Back", learning_entries_path, class: "button" %>
</p>
    