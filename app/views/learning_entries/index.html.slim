.page-container.mt-5

  .search-form

    = form_with url: learning_entries_path,
        method: :get,
        data: { turbo_frame: "learning_entries_results" },
        class: "d-flex gap-2" do

      = text_field_tag :search,
          params[:search],
          class: "form-control",
          placeholder: t("learning_entries.search_placeholder")

      = submit_tag t("learning_entries.search"),
          class: "btn btn-primary"

      - if params[:search].present?
        = link_to t("learning_entries.reset"),
            learning_entries_path,
            class: "btn btn-outline-secondary"

  = render "index_content"