<h1>Daily Learning Tracker</h1>

<%= link_to "Add New Entry", new_learning_entry_path, class: "button" %>

<% if @entries.any? %>

<% @entries.each do |entry| %>

  <div class="entry-card">

   <p>
     <strong>Date:</strong>
     <%= entry.date %>
   </p>

   <p>
     <strong>Topic:</strong>
     <%= entry.topic %>
   </p>

   <p>
     <strong>Hours:</strong>
     <%= entry.hours %>
   </p>

   <p>
     <strong>Notes:</strong>
     <%= entry.notes %>
   </p>

  <div class="entry-actions">
   <%= link_to "Edit", edit_learning_entry_path(entry), class: "button" %>

   <%= link_to "Delete", learning_entry_path(entry), class: "button", data:{
     turbo_method: :delete,
     turbo_confirm:"Are you sure?"
     } %>
   </div>

   </div>

<% end %>

<% else %>

  <p>No learning entries found.</p>

<% end %>
