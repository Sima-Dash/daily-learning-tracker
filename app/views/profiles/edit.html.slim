.container.py-4
  .row.justify-content-center
    .col-md-8.col-lg-6
      .card.shadow-sm.border-0
        .card-body.p-4

          h1.h3.mb-4
            = t("profile.change_password")

          - if @user.errors.any?
            .alert.alert-danger
              ul.mb-0
                - @user.errors.full_messages.each do |message|
                  li = message

          = form_with model: @user,
                      url: profile_path,
                      method: :patch,
                      data: { controller: "validation",
                              validation_message: t("validation.required") } do |form|

            .mb-3
              = form.label :current_password do
                = t("profile.current_password")
                span.text-danger *

              = form.password_field :current_password,
                                    class: "form-control",
                                    required: true

            .mb-3
              = form.label :password do
                = t("profile.new_password")
                span.text-danger *

              = form.password_field :password,
                                    class: "form-control",
                                    required: true

            .mb-3
              = form.label :password_confirmation do
                = t("profile.confirm_new_password")
                span.text-danger *

              = form.password_field :password_confirmation,
                                    class: "form-control",
                                    required: true

            .d-flex.gap-2
              = form.submit t("profile.update_password"),
                            class: "btn btn-primary"

              = link_to t("profile.cancel"),
                        profile_path,
                        class: "btn btn-outline-secondary"